getwd()
r.version
r.version()
version()
Version()
R.version
install.packages("geomedb")
install.packages("devtools")
library(devtools)
install_github("biocodellc/fimsR-access")
install_github("biocodellc/fimsR-access")
library(geomedb)
# 1. discover what's queryable (find the Amphibian Disease project + entity names)
listProjects()          # locate the Amphibian Disease project/team
listEntities()          # confirm which entity holds diseaseDetected etc.
# 2. pull all UK records in one call
uk <- queryMetadata(
entity = "Sample",                       # verify against listEntities()
query  = 'country = "United Kingdom"',
select = c("Event")                      # joins event-level fields: coords, locality, date
)
uk
head(uk)
VIew(uk)
View(uk)
class(uk)
length(uk)                       # 2
names(uk)                        # entity names, e.g. "Sample" "Event"
lapply(uk, dim)                  # rows/cols of each
lapply(uk, names)                # column names in each
# find the column(s) they share — this is your join key
common <- Reduce(intersect, lapply(uk, names))
common                          # almost certainly "eventID"
install.packages('babelquarto', repos = c('https://ropensci.r-universe.dev', 'https://cloud.r-project.org'))
babelquarto::render_book()   # run from the project root
babelquarto::render_book(site_url = 'https://cailadd90.github.io/QGISHandbook/')
babelquarto::render_book(site_url = 'https://cailadd90.github.io/QGISHandbook/')
